# Smart Campus Complaint Management System - local environment
# Copy to .env and adjust. Never commit a real .env with production secrets.

ENVIRONMENT=development
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me-before-submission

# --- PostgreSQL (authoritative relational store) ---
# Unix socket directory (default on Arch Linux / systemd postgres)
POSTGRES_HOST=/run/postgresql
POSTGRES_PORT=5432
POSTGRES_USER=scms
POSTGRES_PASSWORD=scms_dev_pw
POSTGRES_DB=smart_campus
POSTGRES_TEST_DB=smart_campus_test

# --- MongoDB (flexible event store) ---
# User-local mongod started via scripts/start_mongo.sh
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=smart_campus
MONGO_TEST_DB=smart_campus_test

# --- Password hashing ---
BCRYPT_ROUNDS=12

# --- Outbox relay (SQL -> MongoDB event publishing) ---
OUTBOX_POLL_INTERVAL_SECONDS=2.0
OUTBOX_MAX_ATTEMPTS=5

# --- Triage rule cache TTL ---
RULE_CACHE_TTL_SECONDS=60
