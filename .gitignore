# ---------------------------------------------------------------- Python ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.Python

# Virtual environments (.venv is ~617 MB and machine-specific)
.venv/
venv/
env/
ENV/

# ------------------------------------------------------------- Secrets ---
# .env holds the SECRET_KEY and database credentials. Never commit it;
# .env.example is the tracked template.
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# ---------------------------------------------------------- Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.mypy_cache/
.ruff_cache/

# --------------------------------------------------------------- Editors ---
.vscode/
.idea/
*.swp
*.swo
*~

# ------------------------------------------------------------------ OS ----
.DS_Store
Thumbs.db

# --------------------------------------------------------------- Runtime ---
*.log
*.pid

# ------------------------------------------------------------ ML artefacts ---
# The trained pipeline is regenerated by `python ml/train.py` and is
# reproducible from data/raw/complaints.csv, so it is not tracked. Keeping it
# out avoids committing a binary blob that goes stale the moment the corpus
# changes. Commit it deliberately with:
#     git add -f ml/models/*.joblib
ml/models/*.joblib

# Metrics reports ARE tracked: they are the evidence behind docs/ml_report.md
# and must stay in step with it.
# ml/reports/ is deliberately NOT ignored.

# ------------------------------------------------------------------ Notes ---
# Specimen documents are kept locally, not in the repository.
*.docx
!docs/**/*.docx

# --------------------------------------------------------------- Editors ---
*.tmp
*.bak